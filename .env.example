# Copy this file to ".env" and fill in the keys you want to activate.
# Every key is OPTIONAL — with none set, the app runs fully in test/sim mode.
# Never share these keys or commit .env (it is gitignored). Restart the dev
# server after editing so the values are picked up.

# --- Payments: Stripe TEST secret key -------------------------------------
# Free at https://dashboard.stripe.com/test/apikeys — use the sk_test_ one.
# Without it, checkout uses the built-in sandbox (test card 4242 4242 4242 4242).
STRIPE_SECRET_KEY=sk_test_your_key_here

# --- Transactional email: Resend ------------------------------------------
# Free key at https://resend.com/api-keys (starts with re_). Sends the booking
# confirmation and the "sale window opened" alert. Without it, those mails are
# prepared but not delivered (the app reports them as simulated).
RESEND_API_KEY=re_your_key_here
# Optional verified sender. Defaults to Resend's onboarding@resend.dev sandbox.
EMAIL_FROM=Spoorwijs <onboarding@resend.dev>

# --- Fase 2: booking aggregator (real prices + bookable tickets) ----------
# Requires a signed partner contract (Distribusion / Trainline). Without it,
# search falls back to the live open-data timetable and the built-in planner.
# NOTE: the response mapping still has to be completed against the partner's
# live schema before real results appear — see server/aggregator-dev.mjs.
DISTRIBUSION_API_KEY=
